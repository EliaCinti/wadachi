# Real deploy target for scripts/deploy-site.sh — NEVER commit this file.
# Publishing the origin address defeats the Cloudflare proxy in front of it.
# The host itself is the `vps` alias in ~/.ssh/config, so the address lives
# in exactly one local file.
WADACHI_DEPLOY_DEST="vps:/home/elia/engram/"
WADACHI_DEPLOY_KEY="$HOME/.ssh/eliacinti_vps"
