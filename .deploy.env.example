# Copy to .deploy.env (git-ignored) and fill in. Used by scripts/deploy-site.sh.
#
# The origin sits behind Cloudflare, and hiding it is half of what the proxy
# buys you — so the real address lives here, outside the repository, and never
# in a tracked file.
WADACHI_DEPLOY_DEST="user@host:/path/to/served/dir/"
WADACHI_DEPLOY_KEY="$HOME/.ssh/your_deploy_key"
